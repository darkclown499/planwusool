<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    <Files .env>
        Order Allow,Deny
        Deny from all
    </Files>

    # Protect sensitive files and directories from web access
    <FilesMatch "(^\.git|^\.svn|^\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock|\.htaccess|\.htpasswd|\.sql|README\.md|DEPLOYMENT\.md|TODO\.md)">
        Order Allow,Deny
        Deny from all
    </FilesMatch>

    # Deny access to backup files
    <FilesMatch "\.(bak|backup|old|orig|swp|save|tmp|tar\.gz|zip)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller...
    RewriteCond %{REQUEST_URI} !(\.css|\.js|\.png|\.jpg|\.jpeg|\.webp|\.gif|robots\.txt|\.ico|\.woff|\.woff2|.ttf|\.svg)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(css|assets|market_assets|images|landing|uploads|storage|installer|js|vendor|build)/(.*)$ public/$1/$2 [L,NC]
</IfModule>
