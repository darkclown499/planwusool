APP_NAME='Wusool Test'
APP_ENV=testing
APP_KEY=base64:F8hkbZrhGNw5dsw16ZhB+8exp5/9NlRUGMA+M4Sk+bQ=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Hebron
APP_LOCALE=ar

DB_CONNECTION=sqlite
DB_DATABASE=storage/testing.sqlite

BROADCAST_DRIVER=log
CACHE_STORE=array
# Browser e2e (php artisan serve --env=testing) needs sessions to survive
# across HTTP requests: `array` is per-request only and cannot persist, so use
# the `file` driver. PHPUnit stays on `array` via phpunit.xml overrides.
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
# `php artisan serve` binds 127.0.0.1, but a `.localhost` cookie domain is
# dropped by the browser for that host (=> 419). Leave SESSION_DOMAIN empty so
# the session cookie is host-only and sent back to the serve host reliably.
SESSION_DOMAIN=

# Test E2E credentials - NOT production, only for local testing
E2E_CUSTOMER_EMAIL=test.customer@example.test
E2E_CUSTOMER_PASSWORD=password
E2E_MERCHANT_EMAIL=test.merchant@example.test
E2E_MERCHANT_PASSWORD=password

MAIL_MAILER=array
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
IS_DEMO=false
