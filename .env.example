# =============================================================================
# Wusool — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env and adjust each value for your deployment.
# NEVER commit the real .env file (it contains secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Wusool"
APP_ENV=local              # local | staging | production
APP_KEY=                   # generate with: php artisan key:generate
APP_DEBUG=false             # ALWAYS set to false in production
APP_URL=http://localhost:8000   # canonical URL, no trailing slash
APP_TIMEZONE=Asia/Gaza
# Arabic is the default language of the whole app (backend, emails, UI).
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

# Store subdomain base domain.
# Every store is served on its own subdomain: {store_slug}.APP_DOMAIN
# Production example: APP_DOMAIN=wusool.ps  (store at https://techvibe.wusool.ps)
# Local development default (when unset): localhost  (store at http://techvibe.localhost)
APP_DOMAIN=wusool.ps

# Demo mode: shows demo stores and one-click demo logins on the login page.
IS_DEMO=false

# Comma-separated proxy / load-balancer IPs so scheme detection (HTTPS,
# HSTS, OAuth redirects) works correctly behind a reverse proxy. Read in
# bootstrap/app.php (the config repository is not bound yet there), so the
# default below applies whenever config is cached. Use '*' behind Cloudflare.
# NOTE: when config is cached, env() in bootstrap/app.php can only see real
# server environment variables, not this .env file; set it there instead if
# you need something other than '*'.
TRUSTED_PROXIES=*

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wusool
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session / Cache / Queue / Broadcasting
# -----------------------------------------------------------------------------
# Production: Use Redis for horizontal scaling. Local: file/database/sync are fine.
SESSION_DRIVER=redis       # redis | database | file
SESSION_LIFETIME=120       # minutes
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false   # set to true when serving over HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.wusool.ps   # leading dot enables cookie sharing across subdomains (store.wusool.ps → wusool.ps)

CACHE_STORE=redis          # redis | file | database
QUEUE_CONNECTION=redis     # redis | database | sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail — required for password reset, OTP login/registration, and alerts.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp           # smtp | log | postmark | resend | sendmail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@wusool.ps
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Social Login (OAuth)
# -----------------------------------------------------------------------------
# Only providers that are fully configured appear as buttons on the login and
# registration pages. Leave a provider blank to hide it.

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple "Sign in with Apple"
APPLE_CLIENT_ID=          # Services ID (e.g. com.example.wusool.service)
APPLE_CLIENT_SECRET=      # optional: a pre-generated ES256 JWT (30–180 days)
APPLE_TEAM_ID=            # Apple Developer team ID (10 characters)
APPLE_KEY_ID=             # key ID of the .p8 signing key
APPLE_PRIVATE_KEY=        # contents of the .p8 key, newlines as literal \n

# Plankton — custom OAuth2 / OIDC provider
PLANKTON_CLIENT_ID=
PLANKTON_CLIENT_SECRET=
PLANKTON_AUTHORIZE_URL=
PLANKTON_TOKEN_URL=
PLANKTON_USERINFO_URL=
PLANKTON_SCOPE=openid profile email

# -----------------------------------------------------------------------------
# Security Headers — see config/security.php for details.
# -----------------------------------------------------------------------------
# SECURITY_X_FRAME_OPTIONS=SAMEORIGIN
# SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
# SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# SECURITY_PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()
# SECURITY_HSTS_ENABLED=true
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# SECURITY_CSP_ENABLED=true
# CSP is emitted only in production by default (local Vite dev server would
# otherwise be blocked -> blank page). Set to true to force it locally too.
# SECURITY_CSP_FORCE_LOCAL=false
# SECURITY_CSP="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"

# -----------------------------------------------------------------------------
# Media / File storage
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=public     # public | s3
# S3-compatible storage (required when FILESYSTEM_DISK=s3):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# Web push notifications (VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wusool.ps

# Floating assistant (OpenAI legacy)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=

# Free Google Gemini AI (gemini-1.5-flash)
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Note: reCAPTCHA for the login/registration forms is configured from the admin
# Settings panel (recaptchaEnabled / recaptchaSiteKey / recaptchaSecretKey) and
# stored in the database — no environment variables are required for it.
# -----------------------------------------------------------------------------
